{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "ScenePath",
            "description": "Scene to run.",
            "default": "res://Test/MobLoadingTest.tscn",
            "type": "promptString"
        }
    ],
    "configurations": [
        {
            "name": "Attach",
            "type": "godot-mono",
            "request": "attach",
            "address": "localhost",
            "port":23685
        },
        {
            "name": "Play",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "C:\\Programs\\Godot\\Godot_v4.4.1-stable_mono_win64.exe",
            "args": ["--debug-collisions", "--verbose"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false
        },
        {
            "name": "Testing Scene",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "C:\\Programs\\Godot\\Godot_v4.4.1-stable_mono_win64.exe",
            "args": ["--debug-collisions", "--verbose", "${input:ScenePath}"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false
        }
    ]
}